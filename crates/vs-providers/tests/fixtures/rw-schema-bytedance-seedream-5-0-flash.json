{
  "openapi": "3.1.0",
  "info": {
    "title": "Runware API - Seedream 5.0 Flash",
    "summary": "Fast, cost-efficient image generation and multi-reference editing with layer decomposition",
    "description": "Seedream 5.0 Flash is the fast, cost-efficient model in ByteDance's Seedream 5.0 family for image generation and editing. It supports text-to-image and reference-guided editing with up to 10 input images, precise local edits targeted with point and bounding-box coordinates in the prompt, transparent-background output, and decomposition of an image into separate transparent layers. It outputs from 1K to 2K and suits high-volume workflows such as ad concepts, thumbnails, social visuals, and rapid design iteration.",
    "version": "1.0.0",
